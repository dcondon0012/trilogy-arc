{
  "name": "trilogy-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Trilogy Medical Networks operations platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm run build && NODE_ENV=production TRILOGY_DISABLE_MFA=1 tsx server/index.ts",
    "start:secure": "npm run build && NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "import-backup": "tsx scripts/import-backup.ts",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1124.0",
    "@aws-sdk/client-sesv2": "^3.1124.0",
    "@aws-sdk/client-textract": "^3.1124.0",
    "@sentry/node": "^10.73.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-session": "^2.1.0",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.1.1",
    "otplib": "^12.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
